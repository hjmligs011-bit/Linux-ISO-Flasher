<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux ISO Flasher</vendor>

  <action id="org.linuxisoflasher.flash">
    <description>Gravar uma imagem em um dispositivo removível</description>
    <description xml:lang="en">Write an image to a removable device</description>
    <message>É necessária autenticação administrativa para gravar a imagem.</message>
    <message xml:lang="en">Administrative authentication is required to write the image.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- O helper é o único código privilegiado; a GUI nunca roda como root. -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/linux-iso-flasher/helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>

#!/usr/bin/make -f
# Regras Debian para gerar o wheel e instalar seus data-files em /usr.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with python3

override_dh_auto_build:
	python3 -m build --wheel --no-isolation --outdir debian/build

override_dh_auto_install:
	python3 -m pip install --no-deps --ignore-installed \
		--root=$(CURDIR)/debian/linux-iso-flasher --prefix=/usr \
		debian/build/*.whl

override_dh_auto_clean:
	rm -rf debian/build
	rm -rf src/*.egg-info
	find . -type d -name __pycache__ -prune -exec rm -rf {} +
